!*********************************STARTUP****************************************
!
PROJECT  'CalBay_Nested'  'Coarse'
!
SET NAUTical
!
MODE DYNAMIC TWODimensional
!
COORDinates SPHErical CCM
!
!*****************************MODEL DESCRIPTION**********************************
!
! PARENT (coarse) grid: same as the original California Bay model
! Rotated 22.467 deg, origin at SF Bay entrance
! 120 x 216 cells at ~0.00416 deg resolution (~460 m)
!
CGRID REGular -122.3018 37.2947 22.467 0.4992 0.8986 120 216 CIRcle 36 0.04 0.5 30
!
!*****************************INPUT GRIDS & DATA*********************************
!
! Bathymetry from GEBCO (1680 x 1920 cells, 0.00417 deg)
INPgrid BOTtom REGular -125.0 34.0 0. 1679 1919 0.00416667 0.00416667 EXCeption -32767.
READinp BOTtom 1.0 'GEBCO.asc' 1 6 FREE
!
! Wind from ERA5 (29 lon x 33 lat at 0.25 deg, hourly Jan-Feb 2024)
INPgrid WInd REGular -125.0 34.0 0. 28 32 0.25 0.25 &
       NONSTATionary 20240101.000000 1 HR 20240229.230000
READinp WInd 1.0 'wind.inp' 3 0 FREE
!
!*************************BOUNDARY & INITIAL CONDITION***************************
!
BOUnd SHAPespec JONswap 3.3 PEAK DSPR DEGRees
!
! Wave boundary on western (ocean-facing) side from ERA5 TPAR
BOUndspec SIDE W CCW VARiable FILE 0.0 'BW2.TPAR'
!
!***********************************PHYSICS**************************************
!
! Third-generation source terms (Komen et al.)
GEN3 KOMen 1.36e-5 2.02e-3 DRAG WU AGROW
!
! Swell dissipation (Zieger et al.)
SSWELL ZIEGER 0.00025
NEGATINP 0.04
!
! Whitecapping
WCAP KOMen 1.36e-5 2.02e-3 2. 1. 1.
!
! Depth-induced breaking (Battjes & Janssen)
BREaking CONstant 1. 0.73
!
! Bottom friction (JONSWAP)
FRICtion JONswap CONstant 0.038
!
! Diffraction
DIFFRACtion 1 0. 0. 1
!
!**********************************NUMERICS**************************************
!
!***********************************OUTPUT***************************************
!
! --- NESTOUT: save spectral boundary for the nested (fine) grid ---
! The nested grid covers the high-energy deployment zone:
!   Origin: (-122.40, 37.60), Size: 0.30 x 0.30 deg, Rotation: 0 deg
!
NGRID 'nest_zone' -122.40 37.60 0. 0.30 0.30 60 60
NESTOUT 'nest_zone' 'nest_boundary.bnd' OUTPUT 20240101.000000 1 HR
!
! Block output on coarse grid for comparison
BLOCK 'COMPGRID' NOHEAD 'coarse_block.mat' LAY-OUT 3 XP YP HSIGN RTP DIR DEPTH &
      OUTPUT 20240101.030000 6 HR
!
!***********************************COMPUTE**************************************
!
COMPute NONSTATionary 20240101.000000 1 HR 20240229.230000
!
STOP
