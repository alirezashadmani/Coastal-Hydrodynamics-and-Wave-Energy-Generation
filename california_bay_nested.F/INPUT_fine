!*********************************STARTUP****************************************
!
PROJECT  'CalBay_Nest'  'F'
!
SET NAUTical
!
MODE DYNAMIC TWODimensional
!
COORDinates SPHErical CCM
!
!*****************************MODEL DESCRIPTION**********************************
!
! NESTED (fine) grid: high-resolution domain over the WEC deployment zone
! Centered on the high-energy area identified by AHP-TOPSIS site selection
! Origin: (-122.40, 37.60), Size: 0.30 x 0.30 deg, Rotation: 0 deg
! 300 x 300 cells at ~0.001 deg resolution (~100 m)
! Resolution ratio: ~4.2x finer than the coarse grid (~460 m -> ~100 m)
!
CGRID REGular -122.40 37.60 0. 0.30 0.30 300 300 CIRcle 36 0.04 0.5 30
!
!*****************************INPUT GRIDS & DATA*********************************
!
! Bathymetry: same GEBCO file — SWAN interpolates to the fine grid
INPgrid BOTtom REGular -125.0 34.0 0. 1679 1919 0.00416667 0.00416667 EXCeption -32767.
READinp BOTtom 1.0 'GEBCO.asc' 1 6 FREE
!
! Wind: same ERA5 field
INPgrid WInd REGular -125.0 34.0 0. 28 32 0.25 0.25 &
       NONSTATionary 20240101.000000 1 HR 20240229.230000
READinp WInd 1.0 'wind.inp' 3 0 FREE
!
!*************************BOUNDARY & INITIAL CONDITION***************************
!
BOUnd SHAPespec JONswap 3.3 PEAK DSPR DEGRees
!
! --- NESTINP: read spectral boundary from the coarse (parent) run ---
NGRID 'nestzn' -122.40 37.60 0. 0.30 0.30 60 60
NESTINP 'nestzn' 'nest_boundary.bnd'
!
!***********************************PHYSICS**************************************
!
! Same physics as the coarse grid for consistency
GEN3 KOMen 1.36e-5 2.02e-3 DRAG WU AGROW
!
SSWELL ZIEGER 0.00025
NEGATINP 0.04
!
WCAP KOMen 1.36e-5 2.02e-3 2. 1. 1.
!
BREaking CONstant 1. 0.73
!
FRICtion JONswap CONstant 0.038
!
DIFFRACtion 1 0. 0. 1
!
!**********************************NUMERICS**************************************
!
!***********************************OUTPUT***************************************
!
! Block output on the fine grid
BLOCK 'COMPGRID' NOHEAD 'fine_block.mat' LAY-OUT 3 XP YP HSIGN RTP DIR DEPTH &
      OUTPUT 20240101.030000 1 HR
!
!***********************************COMPUTE**************************************
!
COMPute NONSTATionary 20240101.000000 1 HR 20240229.230000
!
STOP
